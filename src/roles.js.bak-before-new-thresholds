export function createRoles(players) {
  const total = players.length;

  if (!Number.isInteger(total) || total < 5 || total > 15) {
    throw new Error('Jumlah pemain harus 5 sampai 15 orang.');
  }

  let roles = [];

  if (total <= 6) {
    roles = [
      'Werewolf',
      'Seer',
      'Doctor'
    ];
  } else if (total === 7) {
    roles = [
      'Werewolf',
      'Werewolf',
      'Seer',
      'Doctor'
    ];
  } else if (total <= 9) {
    roles = [
      'Werewolf',
      'Werewolf',
      'Seer',
      'Doctor',
      'Witch',
      'Hunter',
      'Guardian'
    ];
  } else {
    roles = [
      'Werewolf',
      'Werewolf',
      'Alpha Werewolf',
      'Seer',
      'Doctor',
      'Witch',
      'Hunter',
      'Guardian',
      'Cupid',
      'Jester'
    ];

    if (total >= 12) {
      roles.push('Detective');
    }

    if (total >= 13) {
      roles.push('Sorcerer');
    }
  }

  roles.push(...Array(total - roles.length).fill('Villager'));

  // Acak urutan role
  for (let i = roles.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [roles[i], roles[j]] = [roles[j], roles[i]];
  }

  return players.map((jid, i) => ({
    jid,
    role: roles[i]
  }));
}

